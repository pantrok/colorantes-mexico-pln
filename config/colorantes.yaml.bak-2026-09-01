# Diccionario semilla de colorantes alimentarios en español (México)
# y matriz tono x solubilidad para la regla de sustituibilidad.
#
# SEMILLA, no versión final. El diccionario definitivo se construye a partir de
# las denominaciones que aparezcan realmente en el texto del subconjunto mexicano.
# Toda adición debe registrarse en config/CAMBIOS.md con la razón.
#
# clase: sintetico | natural | fuera_de_eje
# tono:  amarillo | naranja | rojo | rosa | azul | verde | pardo | negro | blanco
# base:  hidrosoluble | liposoluble | dispersable | mineral
# Los términos van en minúscula y sin acentos: la normalización los compara así.

meta:
  version: "0.1"
  fecha: "2026-08-23"
  nota: "Semilla construida a partir de literatura y conocimiento de dominio, sin ver los datos."

sinteticos:
  E102:
    nombre: tartrazina
    tono: amarillo
    base: hidrosoluble
    terminos: [tartrazina, "amarillo 5", "amarillo no. 5", "amarillo num. 5",
               "fd&c amarillo no. 5", "fd&c amarillo 5", "ci 19140", "e-102", "e 102"]
  E104:
    nombre: amarillo de quinoleina
    tono: amarillo
    base: hidrosoluble
    terminos: ["amarillo de quinoleina", "amarillo quinoleina"]
  E110:
    nombre: amarillo ocaso FCF
    tono: naranja
    base: hidrosoluble
    terminos: ["amarillo ocaso", "amarillo crepusculo", "amarillo 6", "amarillo no. 6",
               "fd&c amarillo no. 6", "sunset yellow", "ci 15985", "e-110", "e 110"]
  E122:
    nombre: azorrubina / carmoisina
    tono: rojo
    base: hidrosoluble
    terminos: [carmoisina, azorrubina, "ci 14720"]
  E124:
    nombre: rojo ponceau 4R
    tono: rojo
    base: hidrosoluble
    # TRAMPA: "rojo cochinilla A" es SINTETICO. No confundir con cochinilla (E120).
    terminos: ["rojo ponceau", "ponceau 4r", "rojo cochinilla a", "ci 16255"]
  E127:
    nombre: eritrosina
    tono: rosa
    base: hidrosoluble
    # Prohibida en Mexico por acuerdo COFEPRIS del 28/05/2026, 24 meses de plazo.
    terminos: [eritrosina, "rojo 3", "rojo no. 3", "fd&c rojo no. 3", "ci 45430"]
  E129:
    nombre: rojo allura AC
    tono: rojo
    base: hidrosoluble
    terminos: ["rojo allura", "allura red", "rojo 40", "rojo no. 40",
               "fd&c rojo no. 40", "fd&c rojo 40", "ci 16035", "e-129", "e 129"]
  E131:
    nombre: azul patente V
    tono: azul
    base: hidrosoluble
    terminos: ["azul patente"]
  E132:
    nombre: indigotina
    tono: azul
    base: hidrosoluble
    # TRAMPA: "carmin de indigo" es SINTETICO. No confundir con carmin (E120).
    terminos: [indigotina, "carmin de indigo", "azul 2", "azul no. 2",
               "fd&c azul no. 2", "ci 73015"]
  E133:
    nombre: azul brillante FCF
    tono: azul
    base: hidrosoluble
    terminos: ["azul brillante", "azul 1", "azul no. 1", "fd&c azul no. 1", "ci 42090"]
  E142:
    nombre: verde S
    tono: verde
    base: hidrosoluble
    terminos: ["verde s", "verde acido brillante"]
  E143:
    nombre: verde rapido FCF
    tono: verde
    base: hidrosoluble
    terminos: ["verde rapido", "verde 3", "verde no. 3", "fd&c verde no. 3"]
  E151:
    nombre: negro brillante BN
    tono: negro
    base: hidrosoluble
    terminos: ["negro brillante"]

naturales:
  E100:
    nombre: curcumina
    tono: amarillo
    base: liposoluble
    # Ambiguo: puede aparecer como especia y no como colorante. Requiere contexto.
    terminos: [curcumina, curcuma, "extracto de curcuma", "oleorresina de curcuma"]
    ambiguo_uso: true
  E101:
    nombre: riboflavina
    tono: amarillo
    base: hidrosoluble
    # Origen no recuperable de la etiqueta (fermentacion o sintesis).
    # Ademas suele usarse como vitamina, no como colorante.
    terminos: [riboflavina, lactoflavina, "vitamina b2", "vitamina b-2"]
    origen_indeterminado: true
    ambiguo_uso: true
  E120:
    nombre: carmin / acido carminico
    tono: rojo
    base: hidrosoluble
    # Se reporta POR SEPARADO del agregado natural: su barrera es de certificacion.
    terminos: [carmin, carmines, "acido carminico", cochinilla, "grana cochinilla",
               "carmin de cochinilla", "rojo carmin", "ci 75470", "extracto de cochinilla"]
    reportar_aparte: true
    barrera: certificacion
  E140:
    nombre: clorofilas
    tono: verde
    base: liposoluble
    terminos: [clorofila, clorofilas, clorofilina, clorofilinas]
    origen_indeterminado: true
  E141:
    nombre: complejos cupricos de clorofilas
    tono: verde
    base: liposoluble
    terminos: ["complejos cupricos de clorofila", "clorofilina cuprica"]
  E153:
    nombre: carbon vegetal
    tono: negro
    base: dispersable
    terminos: ["carbon vegetal", "carbon activado", "carbon medicinal"]
  E160a:
    nombre: carotenos
    tono: amarillo
    base: liposoluble
    # ORIGEN NO RECUPERABLE: extracto vegetal o betacaroteno de sintesis, mismo codigo.
    # Es el colorante mas frecuente segun la auditoria de Hong Kong (Chiu 2025).
    terminos: [betacaroteno, "beta caroteno", "beta-caroteno", carotenos, caroteno,
               "caroteno natural", "extracto de zanahoria", "carotenos mixtos"]
    origen_indeterminado: true
  E160b:
    nombre: annatto / achiote
    tono: naranja
    base: liposoluble
    # Muy relevante en Mexico.
    terminos: [achiote, annatto, atsuete, bixina, norbixina, "extracto de achiote", urucu]
  E160c:
    nombre: extracto de paprika
    tono: naranja
    base: liposoluble
    terminos: [paprika, "oleorresina de paprika", "extracto de paprika",
               "extracto de pimenton", capsantina, capsorrubina]
  E160d:
    nombre: licopeno
    tono: rojo
    base: liposoluble
    terminos: [licopeno]
  E161b:
    nombre: luteina
    tono: amarillo
    base: liposoluble
    terminos: [luteina]
  E162:
    nombre: rojo de betabel / betanina
    tono: rojo
    base: hidrosoluble
    terminos: [betanina, betalaina, betalainas, "extracto de betalaina",
               "rojo de betabel", "rojo de remolacha", "extracto de betabel",
               "jugo de betabel", "concentrado de betabel", "polvo de betabel"]
  E163:
    nombre: antocianinas
    tono: rojo
    base: hidrosoluble
    terminos: [antocianina, antocianinas, enocianina, "extracto de col morada",
               "extracto de uva", "extracto de piel de uva", "extracto de jamaica",
               hibisco, "extracto de hibisco", "extracto de zanahoria morada",
               "extracto de maiz morado", "extracto de camote morado",
               "extracto de rabano", "concentrado de sauco"]
  E170:
    nombre: carbonato de calcio
    tono: blanco
    base: mineral
    terminos: ["carbonato de calcio"]
  E171:
    nombre: dioxido de titanio
    tono: blanco
    base: mineral
    terminos: ["dioxido de titanio"]
  E172:
    nombre: oxidos de hierro
    tono: pardo
    base: mineral
    terminos: ["oxido de hierro", "oxidos de hierro"]
  SPIRULINA:
    nombre: extracto de espirulina / ficocianina
    tono: azul
    base: hidrosoluble
    # Sin numero E en la UE; el unico azul natural con uso real.
    terminos: [espirulina, "extracto de espirulina", ficocianina]

fuera_de_eje:
  E150:
    nombre: colorantes caramelo
    tono: pardo
    base: hidrosoluble
    # Decision de la Dra.: irrelevante para el eje de sustitucion. No se cuenta
    # ni como natural ni como sintetico. Se menciona en discusion como ejemplo de
    # tono sin sustituto viable, por tono y por facilidad tecnica de obtencion.
    terminos: ["color caramelo", "colorante caramelo", caramelo,
               "caramelo clase iii", "caramelo clase iv", "caramelo amonico",
               "caramelo al sulfito de amonio", "e-150", "e 150",
               "e150a", "e150b", "e150c", "e150d"]

# Frases genericas: no identifican sustancia pero si intencion declarativa.
# Utiles para medir cuantos productos declaran color sin nombrar el compuesto.
genericos:
  terminos: ["colorante natural", "colorantes naturales", "colorante artificial",
             "colorantes artificiales", "color artificial", "colores artificiales",
             "colorante permitido", "colorantes permitidos", "color anadido",
             "sin colorantes artificiales", "libre de colorantes",
             "colorante vegetal", "colorantes vegetales"]

# Regla de sustituibilidad, version minima fijada A PRIORI (va en Metodos).
# Un reemplazo es plausible solo si coinciden familia de tono Y base.
# El razonamiento completo por pH y carga termica va en Discusion, no aqui.
sustituibilidad:
  regla: "coincidencia de tono Y de base"
  candidatos:
    E102: [E100, E101, E161b]        # amarillo; P2: los naturales son liposolubles salvo E101
    E110: [E160a, E160b, E160c]      # naranja
    E122: [E120, E162, E163, E160d]
    E124: [E120, E162, E163, E160d]
    E127: [E120, E162, E163]
    E129: [E120, E162, E163, E160d]
    E131: [SPIRULINA]
    E132: [SPIRULINA]                # P1: practicamente sin reemplazo viable
    E133: [SPIRULINA]                # P1
    E142: [E140, E141]
    E143: [E140, E141]
    E151: [E153]
  notas:
    P1: "Azul: solo espirulina, de estabilidad limitada. Prediccion de no sustitucion."
    P2: "Amarillo: E100 y E161b son liposolubles; en bebida acuosa requieren emulsion. Prediccion de persistencia de E102 en bebidas."
    base_no_coincide: "Si el candidato no comparte base, no cuenta como sustitucion aunque coincida el tono."
